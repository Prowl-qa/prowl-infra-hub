{
  "name": "prowl-infra-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx scripts/seed.ts",
    "test:playbook": "npx tsx cli/index.ts test",
    "test:playbook:all": "npx tsx cli/index.ts test --all",
    "test:playbook:ec2": "npx tsx cli/index.ts test --driver ec2",
    "test:playbook:ec2:all": "npx tsx cli/index.ts test --all --driver ec2 --env all",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --target=node20 --outfile=cli/dist/cli.js && chmod +x cli/dist/cli.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.1.6",
    "typescript": "^5.9.3"
  }
}
